# Copy to .env at the repo root. Every app reads this file in development.

# --- shared (api, worker, db) ---
NODE_ENV=development
LOG_LEVEL=info
TENANT_ID=default
DATABASE_URL=postgresql://oneix:oneix@localhost:5432/oneix
REDIS_URL=redis://localhost:6379

# Ticketing backend (Zendesk). Never exposed to web or widget.
# Set ONE way to authenticate. If several are set, the first in this list wins:
#   1. ZENDESK_ACCESS_TOKEN                      pre-issued OAuth token
#   2. ZENDESK_EMAIL + ZENDESK_API_TOKEN         API token of an admin (simplest)
#   3. ZENDESK_CLIENT_ID + ZENDESK_CLIENT_SECRET OAuth client, client credentials grant
ZENDESK_SUBDOMAIN=
ZENDESK_ACCESS_TOKEN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
# true: agent actions are sent with X-On-Behalf-Of (OAuth only, token needs the impersonate scope).
# false: notes are attributed through author_id instead.
ZENDESK_IMPERSONATE=false

# --- api ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# At least 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string-0123456789
# Enables the agent picker on the login page. Never enable in production.
AUTH_DEV_LOGIN=true
# Signing secret of the Zendesk webhook that notifies oneix of ticket changes.
ZENDESK_WEBHOOK_SECRET=

# --- worker ---
# Safety-net sync of the ticket cache, in minutes.
TICKET_BACKFILL_INTERVAL_MINUTES=5

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
