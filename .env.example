# Copy to .env at the repo root. Every app reads this file in development.
# npm start creates it for you on the first run.

# --- shared (api, worker) ---
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://oneix:oneix@localhost:5432/oneix
REDIS_URL=redis://localhost:6379
# Encrypts every tenant's Zendesk credentials at rest. 32 random bytes, base64:
#   openssl rand -base64 32
# npm start generates one if this is empty. Keep it safe: without it, stored credentials cannot be read.
ONEIX_ENCRYPTION_KEY=

# --- development tenant ---
# Tenants (clients) and their Zendesk connections live in the database, added with
#   npm run tenant -- add ...
# For local development, npm start connects one tenant from these values, once.
DEV_TENANT_SLUG=
DEV_TENANT_NAME=
ZENDESK_SUBDOMAIN=
# One way to authenticate. If several are set, the first in this list wins:
#   1. ZENDESK_ACCESS_TOKEN                      pre-issued OAuth token
#   2. ZENDESK_EMAIL + ZENDESK_API_TOKEN         API token of an admin (simplest)
#   3. ZENDESK_CLIENT_ID + ZENDESK_CLIENT_SECRET OAuth client, client credentials grant
ZENDESK_ACCESS_TOKEN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
# Signing secret of the tenant's Zendesk webhook, if you set one up.
ZENDESK_WEBHOOK_SECRET=

# --- api ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Enables the tenant and agent picker on the login page. Never enable in production.
AUTH_DEV_LOGIN=true
# API reference (Scalar) at /docs and the OpenAPI document at /openapi.json. Defaults to on outside production.
API_DOCS=true

# --- voice (Cognigy Click To Call and Voice Gateway) ---
# Websites allowed to start calls (POST /widget/calls), comma-separated.
WIDGET_ORIGINS=http://localhost:3002
# Bearer token the Cognigy Flow sends to /voice/flow. Long and random: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VOICE_FLOW_SECRET=
# Voice Gateway account's Webhook Secret; when set, softphone registrations must be signed with it.
VOICE_GATEWAY_WEBHOOK_SECRET=
# SIP realm (domain) of the Voice Gateway account that agents' softphones register in.
VOICE_SIP_REALM=
# Voice Gateway's secure WebSocket for softphones, for example wss://<gateway-host>:8443.
VOICE_GATEWAY_WSS_URL=
# Seconds agents' softphones ring on a handover.
VOICE_RING_TIMEOUT_SECONDS=30

# --- landing (contact center demo page, apps/landing) ---
# Click To Call Endpoint URL from the Cognigy Voice Gateway Endpoint.
NEXT_PUBLIC_COGNIGY_C2C_ENDPOINT_URL=
# The workspace whose agents take the page's calls.
NEXT_PUBLIC_LANDING_TENANT=

# --- Cognigy API (npm run cognigy:flow builds the Flow, AI agent, and Endpoint) ---
# API base URL, for example https://api-app.cognigy.ai (see docs/11-voice-setup-guide.md).
COGNIGY_API_BASE_URL=
# Cognigy: User Menu > My Profile > API Keys > Create New.
COGNIGY_API_KEY=
# The project's ID, from its URL in Cognigy (24 characters).
COGNIGY_PROJECT_ID=
# The forwarded public address of the API (port 4000), which the Flow calls.
ONEIX_PUBLIC_API_URL=
# Optional: Adam's ElevenLabs voice ID (from ElevenLabs' voice library). Empty uses the Endpoint's default voice.
COGNIGY_TTS_VOICE=
# Optional: the language and ElevenLabs model for that voice.
COGNIGY_TTS_LANGUAGE=en-US
COGNIGY_TTS_MODEL=eleven_flash_v2_5

# --- worker ---
# Safety-net sync of every tenant's ticket cache, in minutes.
TICKET_BACKFILL_INTERVAL_MINUTES=5
# How often agents are provisioned from each tenant's Zendesk, in minutes.
AGENT_SYNC_INTERVAL_MINUTES=60
# How often ticket forms and custom fields are copied from each tenant's Zendesk, in minutes.
TICKET_FORM_SYNC_INTERVAL_MINUTES=60

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
