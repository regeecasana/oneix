// oneix data model. See docs/06-data-model.md.
// M1 covers tenants, users, customers, the ticket cache, webhook events, and the audit log.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  invited
  active
  disabled
}

enum AuthTokenPurpose {
  invite
  password_reset
}

enum UserRole {
  agent
  admin
}

enum TicketStatus {
  new
  open
  pending
  on_hold
  solved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum WebhookSource {
  cognigy
  voice_gateway
  zendesk
}

enum ConnectionProvider {
  zendesk
}

enum ConnectionAuthType {
  access_token
  api_token
  oauth_client
}

enum ConnectionStatus {
  active
  failing
  disabled
}

/// How a ticket reached support, grouped for the inbox tabs.
enum TicketChannel {
  email
  chat
  messaging
  sunshine_conversations
  social
  phone
  web_form
  api
  other
}

/// Which tickets an agent may see, mirrored from the backend.
enum TicketAccess {
  all
  groups
  organization
  assigned
  requested
}

enum WebhookEventStatus {
  pending
  processed
  failed
}

/// A client of oneix. Each tenant has its own Zendesk instance and agents.
model Tenant {
  id        String   @id @default(cuid())
  /// URL-safe name, used in webhook URLs and sign-in.
  slug      String   @unique
  name      String
  /// Retry rule, business timezone.
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections   TenantConnection[]
  memberships   TenantMembership[]
  backendAgents BackendAgent[]
  customers     Customer[]
  tickets       Ticket[]
  webhookEvents WebhookEvent[]
  auditLogs     AuditLog[]
}

/// A tenant's connection to a vendor platform. Credentials are encrypted by @oneix/tenancy.
model TenantConnection {
  id            String             @id @default(cuid())
  tenantId      String
  provider      ConnectionProvider
  /// Zendesk subdomain.
  subdomain     String
  authType      ConnectionAuthType
  /// Encrypted JSON. Shape depends on authType.
  credentials   String
  /// Encrypted signing secret of the backend's webhook.
  webhookSecret String?
  impersonate   Boolean            @default(false)
  status        ConnectionStatus   @default(active)
  lastError     String?
  lastCheckedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
}

/// A person who signs in to oneix. One person can work for several tenants through memberships.
model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String
  ssoSubject        String?    @unique
  /// invited until they set a password from their invite link; disabled blocks every sign-in.
  status            UserStatus @default(invited)
  /// scrypt hash; null until the invite is accepted.
  passwordHash      String?
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  /// Consecutive failed sign-ins; the account locks for a while after too many.
  failedLogins      Int        @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  memberships     TenantMembership[]
  assignedTickets Ticket[]
  auditLogs       AuditLog[]
  sessions        Session[]
  authTokens      AuthToken[]        @relation("AuthTokenUser")
}

/// A signed-in browser. The cookie holds a random token; only its hash is stored.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  /// The workspace the session is working in; switching workspace updates it.
  tenantId   String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// One-time links: invitations and password resets. Only the token's hash is stored.
model AuthToken {
  id          String           @id @default(cuid())
  tokenHash   String           @unique
  purpose     AuthTokenPurpose
  userId      String
  /// The workspace an invitation is for.
  tenantId    String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime         @default(now())

  user User @relation("AuthTokenUser", fields: [userId], references: [id])

  @@index([userId, purpose])
}

/// A user in a tenant's ticketing backend (Zendesk), refreshed by the agent sync. oneix accounts
/// are linked to one of these; the directory itself never grants access.
model BackendAgent {
  id                      String             @id @default(cuid())
  tenantId                String
  provider                ConnectionProvider
  externalId              String
  name                    String
  email                   String?
  /// The backend's role: agent or admin.
  role                    UserRole
  roleNames               String[]           @default([])
  canReplyPublicly        Boolean            @default(true)
  ticketAccess            TicketAccess       @default(all)
  groupExternalIds        String[]           @default([])
  organizationExternalIds String[]           @default([])
  /// False when suspended or removed in the backend.
  active                  Boolean            @default(true)
  syncedAt                DateTime
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, email])
}

/// A user's access to one tenant, with their identities in that tenant's platforms.
model TenantMembership {
  id                      String       @id @default(cuid())
  tenantId                String
  userId                  String
  /// oneix role in this workspace: admins manage the team. Independent of the Zendesk role.
  role                    UserRole     @default(agent)
  /// The linked user in this tenant's Zendesk (a BackendAgent's externalId). Without a link the
  /// account can sign in but can't act on tickets. Permissions below are copied from that user.
  zendeskUserId           String?
  /// When an admin confirmed the Zendesk link.
  zendeskLinkedAt         DateTime?
  cxoneAgentId            String?
  /// Every role the agent holds in the backend, as it names them: "Light agent", "Moderator".
  roleNames               String[]     @default([])
  /// False for agents limited to internal notes, such as Zendesk light agents.
  canReplyPublicly        Boolean      @default(true)
  ticketAccess            TicketAccess @default(all)
  /// Backend groups the agent belongs to.
  groupExternalIds        String[]     @default([])
  /// Backend organizations the agent belongs to.
  organizationExternalIds String[]     @default([])
  /// False when the agent was removed or suspended in the backend.
  active                  Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@unique([tenantId, zendeskUserId])
  @@index([userId])
}

model Customer {
  id         String   @id @default(cuid())
  tenantId   String
  name       String?
  email      String?
  /// E.164
  phone      String?
  /// Customer ID in the ticketing backend.
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  tickets Ticket[]

  @@unique([tenantId, externalId])
}

/// A cache of the ticketing backend's ticket. The backend remains the source of truth.
model Ticket {
  id                     String          @id @default(cuid())
  tenantId               String
  /// oneix ticket number, shown in the workspace.
  number                 Int             @unique @default(autoincrement())
  /// Ticket ID in the ticketing backend.
  externalId             String
  customerId             String?
  assigneeId             String?
  subject                String
  /// Backend group the ticket belongs to; group-restricted agents see only their groups' tickets.
  groupExternalId        String?
  /// Backend organization of the requester; organization-restricted agents see only theirs.
  organizationExternalId String?
  channel                TicketChannel   @default(other)
  /// The specific source within the channel, for example "WhatsApp".
  channelDetail          String?
  status                 TicketStatus
  priority               TicketPriority?
  /// Last update time reported by the backend. Older snapshots never overwrite newer ones.
  externalUpdatedAt      DateTime
  lastSyncedAt           DateTime
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  assignee User?     @relation(fields: [assigneeId], references: [id])

  @@unique([tenantId, externalId])
  @@index([tenantId, status, assigneeId])
  @@index([tenantId, groupExternalId])
  @@index([tenantId, channel, externalUpdatedAt(sort: Desc)])
  @@index([tenantId, externalUpdatedAt(sort: Desc), id])
}

model WebhookEvent {
  id          String             @id @default(cuid())
  tenantId    String
  source      WebhookSource
  /// Unique per source, used for idempotency.
  eventKey    String
  payload     Json
  status      WebhookEventStatus @default(pending)
  attempts    Int                @default(0)
  processedAt DateTime?
  error       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, source, eventKey])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  /// For example `ticket.updated`, `ticket.note_added`.
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId, targetType, targetId])
}
