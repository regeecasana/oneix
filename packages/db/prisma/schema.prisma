// oneix data model. See docs/06-data-model.md.
// M1 covers tenants, users, customers, the ticket cache, webhook events, and the audit log.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  agent
  admin
}

enum TicketStatus {
  new
  open
  pending
  on_hold
  solved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum WebhookSource {
  cognigy
  voice_gateway
  zendesk
}

enum ConnectionProvider {
  zendesk
}

enum ConnectionAuthType {
  access_token
  api_token
  oauth_client
}

enum ConnectionStatus {
  active
  failing
  disabled
}

/// Which tickets an agent may see, mirrored from the backend.
enum TicketAccess {
  all
  groups
  organization
  assigned
  requested
}

enum WebhookEventStatus {
  pending
  processed
  failed
}

/// A client of oneix. Each tenant has its own Zendesk instance and agents.
model Tenant {
  id        String   @id @default(cuid())
  /// URL-safe name, used in webhook URLs and sign-in.
  slug      String   @unique
  name      String
  /// Retry rule, business timezone.
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections   TenantConnection[]
  memberships   TenantMembership[]
  customers     Customer[]
  tickets       Ticket[]
  webhookEvents WebhookEvent[]
  auditLogs     AuditLog[]
}

/// A tenant's connection to a vendor platform. Credentials are encrypted by @oneix/tenancy.
model TenantConnection {
  id            String             @id @default(cuid())
  tenantId      String
  provider      ConnectionProvider
  /// Zendesk subdomain.
  subdomain     String
  authType      ConnectionAuthType
  /// Encrypted JSON. Shape depends on authType.
  credentials   String
  /// Encrypted signing secret of the backend's webhook.
  webhookSecret String?
  impersonate   Boolean            @default(false)
  status        ConnectionStatus   @default(active)
  lastError     String?
  lastCheckedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
}

/// A person who signs in to oneix. One person can work for several tenants through memberships.
model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  ssoSubject String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships     TenantMembership[]
  assignedTickets Ticket[]
  auditLogs       AuditLog[]
}

/// A user's access to one tenant, with their identities in that tenant's platforms.
model TenantMembership {
  id               String       @id @default(cuid())
  tenantId         String
  userId           String
  role             UserRole     @default(agent)
  /// Agent in this tenant's Zendesk. Set when agents are provisioned from Zendesk.
  zendeskUserId    String?
  cxoneAgentId     String?
  /// Every role the agent holds in the backend, as it names them: "Light agent", "Moderator".
  roleNames        String[]     @default([])
  /// False for agents limited to internal notes, such as Zendesk light agents.
  canReplyPublicly Boolean      @default(true)
  ticketAccess     TicketAccess @default(all)
  /// False when the agent was removed or suspended in the backend.
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@unique([tenantId, zendeskUserId])
  @@index([userId])
}

model Customer {
  id         String   @id @default(cuid())
  tenantId   String
  name       String?
  email      String?
  /// E.164
  phone      String?
  /// Customer ID in the ticketing backend.
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  tickets Ticket[]

  @@unique([tenantId, externalId])
}

/// A cache of the ticketing backend's ticket. The backend remains the source of truth.
model Ticket {
  id                String          @id @default(cuid())
  tenantId          String
  /// oneix ticket number, shown in the workspace.
  number            Int             @unique @default(autoincrement())
  /// Ticket ID in the ticketing backend.
  externalId        String
  customerId        String?
  assigneeId        String?
  subject           String
  status            TicketStatus
  priority          TicketPriority?
  /// Last update time reported by the backend. Older snapshots never overwrite newer ones.
  externalUpdatedAt DateTime
  lastSyncedAt      DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  assignee User?     @relation(fields: [assigneeId], references: [id])

  @@unique([tenantId, externalId])
  @@index([tenantId, status, assigneeId])
  @@index([tenantId, externalUpdatedAt(sort: Desc), id])
}

model WebhookEvent {
  id          String             @id @default(cuid())
  tenantId    String
  source      WebhookSource
  /// Unique per source, used for idempotency.
  eventKey    String
  payload     Json
  status      WebhookEventStatus @default(pending)
  attempts    Int                @default(0)
  processedAt DateTime?
  error       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, source, eventKey])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  /// For example `ticket.updated`, `ticket.note_added`.
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId, targetType, targetId])
}
